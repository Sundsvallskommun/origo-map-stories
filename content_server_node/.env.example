# Copy this file to .env and fill in real values for this environment.
# .env is gitignored — never commit real secrets.

PORT=3000

# A long random string (at least 32 characters), unique per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# With NODE_ENV=production the server refuses to start if it is missing, still
# a placeholder like the one below, or shorter than 32 characters.
JWT_SECRET=change-me-to-a-long-random-string

# Password required to log in as admin in the browser editor. With
# NODE_ENV=production the server refuses to start if it is missing or still a
# placeholder.
ADMIN_PASSWORD=change-me

# "production" on servers: enables the secret checks above. Leave unset (or
# "development") for local development, where missing secrets fall back to
# insecure defaults. ALLOW_INSECURE_DEFAULTS=1 starts a production server with
# missing or placeholder secrets anyway, with a loud warning (emergencies only).
NODE_ENV=production
# ALLOW_INSECURE_DEFAULTS=1

# PostgreSQL/PostGIS database holding all versioned content; one database per
# installation. Outside production the server warns unless the database name
# ends with _dev, _test or _local (e.g. origo_map_stories_dev), and
# OMS_STRICT_DEV_DB=1 turns the warning into a refusal to start.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/origo_map_stories
# OMS_STRICT_DEV_DB=1

# Optional: version reported by GET /api/version (default: package.json version).
# APP_VERSION=1.0.0
