# Environment for the Origo Map Stories content API container
# (compose env_file / docker run --env-file). Copy to content-api.env, which
# git ignores, and replace every value.
#
# The JWT_SECRET and ADMIN_PASSWORD values below are deliberate placeholders:
# with NODE_ENV=production the server refuses to start while either is still a
# placeholder ("replace-with...", "changeme", "<...>"), is missing, or while
# JWT_SECRET is shorter than 32 characters. Do not work around this with
# ALLOW_INSECURE_DEFAULTS=1.

NODE_ENV=production
PORT=3000

# Path the site is served under, without a trailing slash, e.g. /maps. Empty
# when the site is served from the root. Used in the URLs of uploaded files.
PUBLIC_BASE_PATH=

# Signs admin login tokens. A random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Password for the editor's admin login.
ADMIN_PASSWORD=replace-with-the-admin-password

# PostgreSQL with the PostGIS extension. One database per instance; the
# migrations create the schema at the first start.
DATABASE_URL=postgres://<user>:<password>@<db-host>:5432/<database>
