# Settings of one environment of this installation, read by the
# installation's own deploy scripts. Rename the folder after the environment
# (for example environments/test/, environments/production/).
#
# These values are not secret, but host names and paths are often internal.
# Copy this file to instance.env next to it (gitignored) and fill it in. In a
# private repository you can track instance.env instead by adding
#   !environments/*/instance.env
# to .gitignore. Secrets never go here; they belong in server.env.

# Public URL of the map, with a trailing slash.
SITE_URL=https://maps.example.org/maps/stories/

# Path prefix the map is served under (empty for the site root). The content
# API needs the same value as PUBLIC_BASE_PATH in server.env.
BASE_PATH=/maps/stories

# Server the deploy scripts connect to.
DEPLOY_HOST=web01.example.org
DEPLOY_USER=deploy

# Folder that holds index.html (the map page) on the web server.
SITE_DIR=/srv/www/maps/stories

# Folder the plugin files (plugin/* from the release zip) are copied to.
PLUGIN_DIR=/srv/www/maps/stories/origo-map-stories

# File names the map page loads. Keep the legacy file names (see the
# product's upgrade guide) if an existing page uses them.
PLUGIN_SCRIPT=origo-map-stories.min.js
PLUGIN_STYLESHEET=origo-map-stories.min.css

# Content API container and its env file on the server (container model).
API_CONTAINER=origo-map-stories-api
API_IMAGE=localhost/origo-map-stories-api
API_ENV_FILE=/srv/origo-map-stories/server.env
