# Environment of the Origo Map Stories content API for this environment.
# Copy to server.env ON THE SERVER (never into git), chmod 600, and replace
# every <...> value. The API refuses to start in production while a value is
# missing or still a placeholder. Variables: docs/configuration.md in the
# product repository.

NODE_ENV=production
PORT=3000

# Same as BASE_PATH in instance.env (empty for the site root).
PUBLIC_BASE_PATH=/maps/stories

# Random, at least 32 characters, unique per environment:
#   openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>

# The administrator password, unique per environment.
ADMIN_PASSWORD=<unique admin password>

# One PostgreSQL/PostGIS database per installation and environment.
DATABASE_URL=postgres://<user>:<password>@<database host>:5432/<database name>
