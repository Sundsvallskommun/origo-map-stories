{
  "name": "origo-map-stories",
  "version": "1.0.0",
  "description": "Origo Map Stories: an Origo plugin for telling stories with map content (text panels, layer menus, map links) and its content API",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel watch-js watch-sass watch-server",
    "watch-server": "node content_server_node/server.js",
    "watch-js": "webpack --watch --config ./tasks/webpack.dev.js --mode development",
    "setup": "node scripts/setup.js",
    "prewatch-js": "npm run setup",
    "watch-sass": "sass --watch --load-path scss scss/plugin.scss:../origo/plugins/origo-map-stories.css",
    "prewatch-sass": "sass --load-path scss scss/plugin.scss ../origo/plugins/origo-map-stories.css",
    "build": "webpack --config ./tasks/webpack.prod.js && npm run build-sass && node scripts/copy-legacy-names.js",
    "build-sass": "sass --load-path scss --style=compressed --no-source-map scss/plugin.scss build/css/origo-map-stories.min.css",
    "watch-editor": "webpack --watch --config ./tasks/webpack.editor.js",
    "build-editor": "webpack --config ./tasks/webpack.editor.js --mode production --output-path build/editor",
    "test:server": "node --test \"content_server_node/test/*.test.js\"",
    "check:neutral": "node scripts/check-neutral.js",
    "release:zip": "node scripts/build-release.js",
    "release:verify": "node scripts/build-release.js --verify"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tiptap/core": "^3.23.1",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.30.0",
    "mini-css-extract-plugin": "^2.9.1",
    "npm-run-all2": "^6.2.3",
    "ol": "^10.9.0",
    "proj4": "^2.20.9",
    "sass": "^1.77.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  }
}
